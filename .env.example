# Porta do servidor
PORT=3000

# Pasta onde o banco de dados (arquivo jmr.db) é gravado. Faça backup desta pasta!
DATA_DIR=./data

# Número máximo de empresas
MAX_EMPRESAS=3

# Fuso horário usado para calcular vencimentos e dias de atraso
TZ_EMPRESA=America/Sao_Paulo

# Em produção (com HTTPS), deixe NODE_ENV=production para o cookie de sessão ser seguro
NODE_ENV=production

# Se o sistema rodar atrás de um proxy/servidor (Render, Railway, Nginx), use true
TRUST_PROXY=true
