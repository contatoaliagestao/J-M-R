{
  "name": "jmr-gestao-financeira",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestão de empréstimos, cobrança e conciliação bancária (multi-empresa, até 3 empresas).",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.input.css -o public/tailwind.css --minify",
    "test": "node --test test/*.test.js",
    "reset-senha-admin": "node --env-file-if-exists=.env scripts/reset-admin-password.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
